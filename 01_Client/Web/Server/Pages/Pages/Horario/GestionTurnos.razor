@page "/turnos"
@using Infraestructura.Models.Biometrico
@using Infraestructura.Models.Clasificador
@using Infraestructura.Models.Horario
@using Infraestructura.Models.Persona
@using Microsoft.AspNetCore.Components
@using Syncfusion.Blazor.Grids
@using System.Globalization
@using Server.Pages.Pages.Biometrico
@using Syncfusion.Blazor.Buttons
@inherits MainBaseComponent
@layout MainLayout
@inject NavigationManager Navigation
@inject NavigationManager Nav
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<!-- ============================================================================ -->
<!-- FORMULARIO DE GENERACIÓN - DISEÑO COMPACTO -->
<!-- ============================================================================ -->
<MudCard Elevation="2" Class="mb-3">
    <MudExpansionPanels MultiExpansion="false">
        <MudExpansionPanel @bind-IsExpanded="expande" HideIcon="true">
            <TitleContent>
                <MudStack Row="true"
                          Justify="Justify.SpaceBetween"
                          AlignItems="AlignItems.Center"
                          Class="px-4"
                          Style="width:100%;">

                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                        Generación de Turnos
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="@(expande ? Color.Error : Color.Primary)"
                               OnClick="@ToggleExpand"
                               StartIcon="@(expande ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)">
                        @(expande ? "CERRAR" : "NUEVO")
                    </MudButton>

                </MudStack>
            </TitleContent>

            <ChildContent>
                <MudCardContent>
                    <EditForm Model="@_DiaEvento" OnValidSubmit="OnValidDiaEvento">
                        <DataAnnotationsValidator />

                        <!-- SECCIÓN 1: Selección de Persona -->
                        <MudPaper Class="pa-3 mb-3" Outlined="true">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="PersonaMinDto"
                                                     Value="_personaSeleccionada"
                                                     ValueChanged="OnPersonaChanged"
                                                     ValueExpression="() => _personaSeleccionada"
                                                     ToStringFunc="p => p?.NombreApellido ?? string.Empty"
                                                     SearchFunc="SearchPersonas"
                                                     Label="Funcionario"
                                                     Placeholder="Buscar por nombre..."
                                                     Required="true"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                                     MinCharacters="3"
                                                     DebounceInterval="500" />
                                </MudItem>

                                @if (_infoUltimoTurno != null && _infoUltimoTurno.TieneRegistros)
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="py-1">
                                            <MudText Typo="Typo.caption">
                                                <strong>Último:</strong> @_infoUltimoTurno.Fecha?.ToString("dd/MM/yyyy")
                                                - @_infoUltimoTurno.DescripcionTurno
                                            </MudText>
                                        </MudAlert>
                                    </MudItem>
                                }

                                @if (_infoRango != null && _infoRango.CicloIncompleto)
                                {
                                    <MudItem xs="12">
                                        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Filled" Class="py-2">
                                            <MudText Typo="Typo.body2">
                                                <strong>⚠️ Ciclo incompleto:</strong>
                                                @_infoRango.DiasCompletados /
                                                @(_infoRango.DiasCompletados + _infoRango.DiasFaltantes) días -
                                                @_infoRango.DescripcionTurnoActual
                                                (Faltan @_infoRango.DiasFaltantes días)
                                            </MudText>
                                        </MudAlert>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>

                        <!-- SECCIÓN 2: Configuración de Turnos -->
                        <MudPaper Class="pa-3 mb-3" Outlined="true">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" /> Configuración
                            </MudText>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="3">
                                    <MudSelect T="int"
                                               Label="Grupo de Turno"
                                               @bind-Value="_grupoSeleccionado"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Required="true">
                                        @foreach (var grupo in _listaGrupo ?? Enumerable.Empty<GenGrupoturnoDto>())
                                        {
                                            <MudSelectItem Value="@(grupo.IdgenGrupoturno)">@grupo.Nombre</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>

                                @if (EsGrupoRotativo())
                                {
                                    <MudItem xs="12" sm="2">
                                        <MudSelect T="int?"
                                                   Label="Turno Inicial"
                                                   @bind-Value="_turnoInicialSeleccionado"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Clearable="true">
                                            @foreach (var detalle in _grupoDetalles.Where(d => d.IdgenGrupoturno == _grupoSeleccionado).OrderBy(d => d.Orden))
                                            {
                                                <MudSelectItem Value="@(detalle.Orden)">@detalle.GenClasificadortipo.Abreviatura</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }

                                <MudItem xs="6" sm="2">
                                    <MudDatePicker Label="Inicio"
                                                   @bind-Date="_fechaInicio"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   ReadOnly="@(_infoUltimoTurno?.TieneRegistros == true)"
                                                   HelperText="@(_infoUltimoTurno?.TieneRegistros == true ? "Auto-completado" : "")" />
                                </MudItem>

                                <MudItem xs="6" sm="2">
                                    <MudDatePicker Label="Fin"
                                                   @bind-Date="_fechaFin"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense" />
                                </MudItem>

                                <MudItem xs="12" sm="2">
                                    <MudButton Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               FullWidth="true"
                                               OnClick="GenerarTurnos"
                                               StartIcon="@Icons.Material.Filled.PlayArrow">
                                        Generar
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- SECCIÓN 3: Vista Previa -->
                        @if (_DiasCache.Any())
                        {
                            <MudPaper Class="pa-3" Outlined="true">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                    <MudText Typo="Typo.subtitle2">
                                        <MudIcon Icon="@Icons.Material.Filled.Preview" Size="Size.Small" />
                                        Vista Previa (@_DiasCache.Count días)
                                    </MudText>

                                    <MudButton Color="Color.Success"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               OnClick="GuardarTurnos"
                                               StartIcon="@Icons.Material.Filled.Save">
                                        Guardar
                                    </MudButton>
                                </MudStack>

                                <MudTable Items="_DiasCache"
                                          Dense="true"
                                          Hover="true"
                                          Elevation="0"
                                          Height="300px"
                                          FixedHeader="true">
                                    <HeaderContent>
                                        <MudTh>Fecha</MudTh>
                                        <MudTh>Día</MudTh>
                                        <MudTh>Turno</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="item">
                                        <MudTd>@item.Fecha?.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd>@item.Fecha?.ToString("ddd", new CultureInfo("es-ES"))</MudTd>
                                        <MudTd>
                                            <MudChip Size="Size.Small"
                                                     Style="@($"background-color:{GetChipColorHex(item.IdgenClasificadortipo)}; color:white;")">
                                                @_listaTurnos.FirstOrDefault(t =>
                                                t.IdgenClasificadortipo == item.IdgenClasificadortipo)?.Abreviatura
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudPaper>
                                                }
                    </EditForm>
                </MudCardContent>

            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudCard>

<!-- CALENDARIO MENSUAL - NAVEGACIÓN  -->

<MudCard Elevation="2">
    <MudCardHeader>
        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Spacing="2"
                  Class="flex-wrap">

            <!-- Año actual -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.caption" Color="Color.Primary">
                    @_anioActual
                </MudText>

                <MudStack Row="true" Spacing="1" Class="flex-nowrap">
                    @foreach (var mes in Enumerable.Range(1, 12))
                    {
                        var seleccionado = mes == _mesSeleccionado && _anioSeleccionado == _anioActual;
                        var esHoy = mes == DateTime.Now.Month && _anioActual == DateTime.Now.Year;

                        <MudChip Size="Size.Small"
                                 Clickable="true"
                                 Color="@(esHoy ? Color.Success : seleccionado ? Color.Primary : Color.Default)"
                                 Variant="@(seleccionado ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => CambiarMes(mes, _anioActual))">
                            @ObtenerNombreMesCorto(mes)
                        </MudChip>
                    }
                </MudStack>
            </MudStack>
            <!-- Botón Hoy -->
            <MudIconButton Icon="@Icons.Material.Filled.Today"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="IrAHoy"
                           Title="Ir a hoy" />

            <!-- Año siguiente -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @_anioSiguiente
                </MudText>

                <MudStack Row="true" Spacing="1" Class="flex-nowrap">
                    @foreach (var mes in Enumerable.Range(1, 12))
                    {
                        var seleccionado = mes == _mesSeleccionado && _anioSeleccionado == _anioSiguiente;

                        <MudChip Size="Size.Small"
                                 Clickable="true"
                                 Color="@(seleccionado ? Color.Primary : Color.Default)"
                                 Variant="@(seleccionado ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => CambiarMes(mes, _anioSiguiente))">
                            @ObtenerNombreMesCorto(mes)
                        </MudChip>
                    }
                </MudStack>
            </MudStack>


        </MudStack>
    </MudCardHeader>

    <MudCardContent>
        <div style="overflow-x: auto;">
            <MudTable Items="@_personasConTurnos"
                      Dense="true"
                      Bordered="true"
                      Hover="true"
                      Striped="true"
                      FixedHeader="true"
                      Height="550px">
                <HeaderContent>
                    <MudTh Style="position: sticky; left: 0; background-color: var(--mud-palette-background); z-index: 10; min-width: 180px;">
                        <MudText Typo="Typo.subtitle2">PERSONAL</MudText>
                    </MudTh>
                    @foreach (var dia in _diasDelMes)
                    {
                        var esHoy = dia.Date == DateTime.Now.Date;
                        <MudTh Class="text-center"
                               Style="@($"min-width: 38px; padding: 4px; background-color: {(esHoy ? "#e3f2fd" : "white")}; {(esHoy ? "border: 2px solid #1976d2;" : "")}")">
                            <MudText Typo="Typo.body2" Style="@(esHoy ? "font-weight: bold; color: #1976d2;" : "")">@dia.Day</MudText>
                            <MudText Typo="Typo.caption" Style="font-size: 9px;">
                                @dia.ToString("ddd", new CultureInfo("es-ES")).ToUpper()
                            </MudText>
                        </MudTh>
                    }
                </HeaderContent>

                <RowTemplate>
                    <MudTd Style="position: sticky; left: 0; background-color: var(--mud-palette-background); z-index: 5; font-weight: 500; cursor: pointer;"
                           @onclick="@(() => SeleccionarPersonaDesdeCalendario(context))">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Person"
                                     Size="Size.Small"
                                     Color="Color.Primary" />
                            <MudText Style="text-decoration: none;">
                                @context.FullName
                            </MudText>
                        </MudStack>
                    </MudTd>

                    @foreach (var dia in _diasDelMes)
                    {
                        var evento = _eventosDelMes.FirstOrDefault(e =>
                        e.IdrrhPersona == context.IdrrhPersona &&
                        e.Fecha.HasValue &&
                        e.Fecha.Value.Date == dia.Date);

                        var esHoy = dia.Date == DateTime.Now.Date;
                        var bgColor = esHoy ? "#e3f2fd" : "white";
                        var styleString = $"padding: 2px; background-color: {bgColor};";

                        <MudTd Class="text-center" Style="@styleString">
                            @if (evento != null)
                            {
                                <MudTooltip Text="@GetTooltipText(evento)">
                                    <MudChip Size="Size.Small"
                                             Style="@($"background-color:{GetChipColorHex(evento.IdgenClasificadortipo)}; color:white; cursor: pointer;")"
                                             OnClick="@(() => AbrirDialogEditar(evento))">
                                        @GetTurnoAbreviado(evento.IdgenClasificadortipo)
                                    </MudChip>
                                </MudTooltip>
                            }
                        </MudTd>
                    }
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No hay registros para este mes</MudText>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudCardContent>
</MudCard>

<!-- Leyenda compacta -->
<MudCard Class="mt-2" Elevation="1">
    <MudCardContent Class="py-2">
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
            @foreach (var turno in _listaTurnos ?? Enumerable.Empty<GenClasificadorTipoDto>())
            {
                <MudChip Size="Size.Small"
                         Style="@($"background-color:{GetChipColorHex(turno.IdgenClasificadortipo)}; color:white;")">
                    @turno.Abreviatura - @turno.Descripcion
                </MudChip>
            }
        </MudStack>
    </MudCardContent>
</MudCard>

<!-- ============================================================================ -->
<!-- DIALOG DE EDICIÓN RÁPIDA -->
<!-- ============================================================================ -->
<MudDialog @bind-IsVisible="_dialogEditarVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Cambiar Turno</MudText>

        @if (_eventoEditando != null)
        {
            <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background-color: #f5f5f5;">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.body2" Color="Color.Default">
                            <strong>Fecha:</strong> @_eventoEditando.Fecha?.ToString("dddd, dd/MM/yyyy", new CultureInfo("es-ES"))
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default">
                            <strong>Persona:</strong> @_eventoEditando.RrhPersona?.NombreApellido
                        </MudText>
                    </div>
                    <MudChip Size="Size.Small"
                             Style="@($"background-color:{GetChipColorHex(_eventoEditando.IdgenClasificadortipo)}; color:white;")">
                        Actual: @_listaTurnos.FirstOrDefault(t => t.IdgenClasificadortipo == _eventoEditando.IdgenClasificadortipo)?.Descripcion
                    </MudChip>
                </MudStack>
            </MudPaper>

            <MudText Typo="Typo.subtitle2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Work" Size="Size.Small" /> Turnos Laborales:
            </MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4">
                @foreach (var turno in ObtenerTurnosLaborales())
                {
                    var isSelected = _turnoSeleccionado == turno.IdgenClasificadortipo;
                    <MudChip Size="Size.Medium"
                             Color="@(isSelected ? Color.Primary : Color.Default)"
                             Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => _turnoSeleccionado = turno.IdgenClasificadortipo)"
                             Style="cursor: pointer;">
                        <strong>@turno.Abreviatura</strong> - @turno.Descripcion
                    </MudChip>
                }
            </MudStack>

            <MudText Typo="Typo.subtitle2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" /> Ausencias y Permisos:
            </MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4">
                @foreach (var turno in ObtenerAusenciasPermisos())
                {
                    var isSelected = _turnoSeleccionado == turno.IdgenClasificadortipo;
                    <MudChip Size="Size.Medium"
                             Color="@(isSelected ? Color.Secondary : Color.Default)"
                             Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => _turnoSeleccionado = turno.IdgenClasificadortipo)"
                             Style="cursor: pointer;">
                        <strong>@turno.Abreviatura</strong> - @turno.Descripcion
                    </MudChip>
                }
            </MudStack>

            <MudTextField @bind-Value="_motivoCambio"
                          Label="Motivo del cambio (opcional)"
                          Variant="Variant.Outlined"
                          Lines="2"
                          HelperText="Ej: Cambio por necesidad operativa" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CerrarDialog" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="GuardarCambio"
                   StartIcon="@Icons.Material.Filled.Save">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

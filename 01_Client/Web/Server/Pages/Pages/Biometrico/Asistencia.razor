@page "/asistencia1"
@using Infraestructura.Models.Biometrico
@using Infraestructura.Models.Clasificador
@using Infraestructura.Models.Persona
@using Microsoft.AspNetCore.Components
@using System.Globalization
@using Server.Pages.Pages.Biometrico
@using MudBlazor
@using System.IO
@inherits MainBaseComponent
@layout MainLayout
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">

    <!-- ============================================================ -->
    <!-- HEADER CON FILTROS -->
    <!-- ============================================================ -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudStack Spacing="3">

                <!-- Título -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h5">Control de Asistencia</MudText>
                    </MudStack>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="BuscarAsistencia"
                               Disabled="_cargando">
                        @(_cargando ? "Buscando..." : "Buscar")
                    </MudButton>
                </MudStack>

                <!-- Filtros -->
                <MudGrid Spacing="2">
                    <!-- Fecha Inicio -->
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker Label="Fecha Inicio"
                                       @bind-Date="_fechaInicio"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       DateFormat="dd/MM/yyyy"
                                       Editable="true"
                                       Required="true"
                                       MaxDate="_fechaFin"
                                       HelperText="Inicio del período" />
                    </MudItem>

                    <!-- Fecha Fin -->
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker Label="Fecha Fin"
                                       @bind-Date="_fechaFin"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       DateFormat="dd/MM/yyyy"
                                       Editable="true"
                                       Required="true"
                                       MinDate="_fechaInicio"
                                       HelperText="Fin del período" />
                    </MudItem>

                    <!-- Búsqueda de Persona -->
                    <MudItem xs="12" sm="12" md="6">
                        <MudAutocomplete T="PersonaMinDto"
                                         @bind-Value="_personaSeleccionada"
                                         SearchFunc="BuscarPersonas"
                                         ToStringFunc="@(p => p?.FullName ?? string.Empty)"
                                         Label="Buscar Funcionario"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Placeholder="Escriba nombre o CI..."
                                         Clearable="true"
                                         DebounceInterval="300"
                                         AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                         AdornmentColor="Color.Primary"
                                         HelperText="Dejar vacío para ver todos" />
                    </MudItem>
                </MudGrid>

            </MudStack>
        </MudCardContent>
    </MudCard>

    <!-- ============================================================ -->
    <!-- BLOQUE CONDICIONAL PRINCIPAL -->
    <!-- ============================================================ -->
    @if (_cargando)
    {
        <!-- LOADING -->
        <MudCard Elevation="1">
            <MudCardContent Class="d-flex justify-center align-center" Style="min-height: 300px;">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                    <MudText Typo="Typo.h6">Cargando datos de asistencia...</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
    else if (_datosAsistencia != null && _datosAsistencia.ResumenPorPersona != null && _datosAsistencia.ResumenPorPersona.Any())
    {
        <!-- RESUMEN EN CARDS -->
        <MudGrid Spacing="2" Class="mb-4">
            @foreach (var resumen in _datosAsistencia.ResumenPorPersona)
            {
                <MudItem xs="12">
                    <MudCard Elevation="3">
                        <MudCardContent>
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-3">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.h6">@resumen.NombrePersona</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Default">
                                        <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                                        CI: @resumen.Ci
                                    </MudText>
                                </MudStack>

                                <MudChip Size="Size.Large"
                                         Color="@(resumen.TotalDiasSancion > 0 ? Color.Error : Color.Success)"
                                         Icon="@Icons.Material.Filled.Gavel">
                                    <strong>@resumen.TotalDiasSancion días</strong> de sanción
                                </MudChip>
                            </MudStack>

                            <MudGrid Spacing="2">
                                <MudItem xs="6" sm="3">
                                    <MudPaper Class="pa-3" Style="background: linear-gradient(135deg, #FFA726 0%, #FF6F00 100%);">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Surface" Size="Size.Large" />
                                            <MudText Typo="Typo.h4" Color="Color.Surface">@resumen.MinutosAtrasoAcumulados</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Surface">Min. Atraso</MudText>
                                            <MudDivider DividerType="DividerType.Middle" Style="background-color: rgba(255,255,255,0.3);" />
                                            <MudText Typo="Typo.body2" Color="Color.Surface">
                                                <strong>@resumen.DiasSancionPorAtrasos días</strong>
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="6" sm="3">
                                    <MudPaper Class="pa-3" Style="background: linear-gradient(135deg, #EF5350 0%, #C62828 100%);">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Surface" Size="Size.Large" />
                                            <MudText Typo="Typo.h4" Color="Color.Surface">@resumen.DiasInasistencia</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Surface">Inasistencias</MudText>
                                            <MudDivider DividerType="DividerType.Middle" Style="background-color: rgba(255,255,255,0.3);" />
                                            <MudText Typo="Typo.body2" Color="Color.Surface">
                                                <strong>@resumen.DiasSancionPorInasistencias días</strong>
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="6" sm="3">
                                    <MudPaper Class="pa-3" Style="background: linear-gradient(135deg, #AB47BC 0%, #7B1FA2 100%);">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Login" Color="Color.Surface" Size="Size.Large" />
                                            <MudText Typo="Typo.h4" Color="Color.Surface">@resumen.OmisionesEntrada</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Surface">Sin Entrada</MudText>
                                            <MudDivider DividerType="DividerType.Middle" Style="background-color: rgba(255,255,255,0.3);" />
                                            <MudText Typo="Typo.body2" Color="Color.Surface">
                                                <strong>@resumen.DiasSancionPorOmisiones días</strong>
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="6" sm="3">
                                    <MudPaper Class="pa-3" Style="background: linear-gradient(135deg, #5C6BC0 0%, #3949AB 100%);">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Surface" Size="Size.Large" />
                                            <MudText Typo="Typo.h4" Color="Color.Surface">@resumen.OmisionesSalida</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Surface">Sin Salida</MudText>
                                            <MudDivider DividerType="DividerType.Middle" Style="background-color: rgba(255,255,255,0.3);" />
                                            <MudText Typo="Typo.caption" Color="Color.Surface" Style="opacity: 0.8;">
                                                Incluido en total
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <!-- TABLA DE REGISTROS DIARIOS -->
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                        <MudText Typo="Typo.h6">Detalle Diario</MudText>
                        <MudChip Size="Size.Small" Color="Color.Info">
                            @(_datosAsistencia?.Resultados?.Count ?? 0) registros
                        </MudChip>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudTable Items="@(_datosAsistencia?.Resultados ?? new List<AsistenciaDiaDto>())"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          FixedHeader="true"
                          Height="600px"
                          Breakpoint="Breakpoint.Sm">

                    <HeaderContent>
                        <MudTh>Codigo</MudTh>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Día</MudTh>
                        <MudTh Class="d-none d-md-table-cell">Persona</MudTh>
                        <MudTh>Turno</MudTh>
                        <MudTh Class="d-none d-sm-table-cell">Entrada Prog.</MudTh>
                        <MudTh Class="d-none d-sm-table-cell">Salida Prog.</MudTh>
                        <MudTh>Marcación Entrada</MudTh>
                        <MudTh Class="d-none d-lg-table-cell">Marcación Salida</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Cod.">
                            <MudText Typo="Typo.caption">@context.IdrrhDiaevento</MudText>
                        </MudTd>
                        <MudTd DataLabel="Fecha">
                            <MudText Typo="Typo.body2"><strong>@context.Fecha.ToString("dd/MM/yyyy")</strong></MudText>
                        </MudTd>
                        <MudTd DataLabel="Día">
                            <MudText Typo="Typo.caption">@context.Dia</MudText>
                        </MudTd>
                        <MudTd DataLabel="Persona" Class="d-none d-md-table-cell">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">@context.NombrePersona</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">CI: @context.Ci</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Turno">
                            <MudText Typo="Typo.caption">@context.Turno</MudText>
                        </MudTd>
                        <MudTd DataLabel="Entrada Prog." Class="d-none d-sm-table-cell">
                            @if (context.HoraEntradaProgramada.HasValue)
                            {
                                <MudText Typo="Typo.body2">@context.HoraEntradaProgramada.Value.ToString(@"hh\:mm")</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Default">-</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Salida Prog." Class="d-none d-sm-table-cell">
                            @if (context.HoraSalidaProgramada.HasValue)
                            {
                                <MudText Typo="Typo.body2">@context.HoraSalidaProgramada.Value.ToString(@"hh\:mm")</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Default">-</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Marcación Entrada">
                            @if (context.MarcacionEntrada.HasValue)
                            {
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@context.MarcacionEntrada.Value.ToString("HH:mm:ss")</MudText>
                                    @if (context.MinutosAtraso.HasValue && context.MinutosAtraso > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning">+@context.MinutosAtraso min</MudText>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Error" Size="Size.Small" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Marcación Salida" Class="d-none d-lg-table-cell">
                            @if (context.MarcacionSalida.HasValue)
                            {
                                <MudText Typo="Typo.body2">@context.MarcacionSalida.Value.ToString("HH:mm:ss")</MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Default" Size="Size.Small" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            @{
                                var (color, icon, texto) = GetEstadoProps(context.Estado);
                            }
                            <MudChip Size="Size.Small" Color="@color" Icon="@icon">@texto</MudChip>
                        </MudTd>

                        <MudTd DataLabel="Acciones">
                            @if (PuedeJustificar(context))
                            {
                                <MudTooltip Text="Justificar omisión">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => AbrirDialogJustificacion(context))" />
                                </MudTooltip>
                            }

                            @if (context.IdJustificacion.HasValue)
                            {
                                <MudTooltip Text="Ver justificación">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => VerDetalleJustificacion(context))" />
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>

                    <NoRecordsContent>
                        <MudAlert Severity="Severity.Info">No se encontraron registros para el período seleccionado</MudAlert>
                    </NoRecordsContent>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <!-- ESTADO VACÍO -->
        <MudCard Elevation="1">
            <MudCardContent Class="d-flex justify-center align-center" Style="min-height: 400px;">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" Style="font-size: 5rem;" />
                    <MudText Typo="Typo.h5" Color="Color.Default">Sin datos</MudText>
                    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default">
                        Seleccione un rango de fechas y haga clic en "Buscar" <br />
                        para ver los registros de asistencia
                    </MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

<!-- ============================================================ -->
<!-- DIALOG: CREAR/EDITAR JUSTIFICACIÓN -->
<!-- ============================================================ -->
<MudDialog @bind-IsVisible="_dialogJustificacionVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" />
            @(_modoEdicion ? "Editar Justificación" : "Justificar Omisión")
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (_registroSeleccionado != null)
        {
            <!-- Información del día -->
            <MudExpansionPanels Dense="true" Class="mb-3">
                <MudExpansionPanel Text="Información del día">
                    <MudGrid Dense="true">
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption"><strong>Fecha:</strong></MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">
                                @_registroSeleccionado.Fecha.ToString("dd/MM/yyyy")
                                (@_registroSeleccionado.Dia)
                            </MudText>
                        </MudItem>

                        <MudItem xs="6">
                            <MudText Typo="Typo.caption"><strong>Turno:</strong></MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">@_registroSeleccionado.Turno</MudText>
                        </MudItem>

                        <MudItem xs="6">
                            <MudText Typo="Typo.caption"><strong>Entrada:</strong></MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">
                                @(_registroSeleccionado.HoraEntradaProgramada?.ToString(@"hh\:mm") ?? "-")
                            </MudText>
                        </MudItem>

                        <MudItem xs="6">
                            <MudText Typo="Typo.caption"><strong>Salida:</strong></MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">
                                @(_registroSeleccionado.HoraSalidaProgramada?.ToString(@"hh\:mm") ?? "-")
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>


            <MudGrid>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Seleccione el tipo de omisión que desea justificar
                    </MudAlert>
                </MudItem>

                <!-- Tipo de Omisión -->
                <MudItem xs="12">
                    <MudRadioGroup @bind-SelectedOption="_tipoOmision">
                        @if (!_registroSeleccionado.MarcacionEntrada.HasValue && !_registroSeleccionado.MarcacionSalida.HasValue)
                        {
                            <MudRadio Option="@("AMBAS")" Color="Color.Primary">
                                <strong>Ambas</strong> - No marqué entrada ni salida
                            </MudRadio>
                        }
                        @if (!_registroSeleccionado.MarcacionEntrada.HasValue)
                        {
                            <MudRadio Option="@("ENTRADA")" Color="Color.Primary">
                                <strong>Entrada</strong> - No marqué entrada
                            </MudRadio>
                        }
                        @if (!_registroSeleccionado.MarcacionSalida.HasValue)
                        {
                            <MudRadio Option="@("SALIDA")" Color="Color.Primary">
                                <strong>Salida</strong> - No marqué salida
                            </MudRadio>
                        }
                    </MudRadioGroup>
                </MudItem>

                <!-- Observaciones -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_observaciones"
                                  Label="Observaciones"
                                  Placeholder="Explique el motivo de la omisión..."
                                  Variant="Variant.Outlined"
                                  MaxLength="500"
                                  Counter="500" />
                </MudItem>

                <!-- ✅ CARGA DE ARCHIVO - ÁREA DE TRABAJO -->
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <InputFile id="fileInputArea"
                                   OnChange="@(e => OnFileChangedInput(e, "area"))"
                                   hidden
                                   accept="image/*,.pdf" />

                        <MudButton HtmlTag="label"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   FullWidth="true"
                                   for="fileInputArea">
                            📷 Subir Foto Área de Trabajo
                        </MudButton>

                        @if (_archivoArea != null)
                        {
                            <MudChip Color="Color.Success"
                                     Size="Size.Small"
                                     OnClose="@(() =>
                                                                                                                                                                                         {
                                                                                                                                                                                             _archivoArea = null;
                                                                                                                                                                                             _previewAreaBase64 = null;
                                                                                                                                                                                         })">
                        ✓ @_archivoArea.Name (@FormatBytes(_archivoArea.Size))
                    </MudChip>
                    @if (_previewAreaBase64 != null)
                            {
                                <MudPaper Class="pa-1 mt-2" Elevation="1">
                                    <MudImage Src="@_previewAreaBase64"
                                              Alt="Vista previa área"
                                              Style="max-height:180px; width:100%; object-fit:cover; border-radius:8px;" />
                                </MudPaper>
                            }
                            else if (_archivoArea != null && Path.GetExtension(_archivoArea.Name).ToLower() == ".pdf")
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" />
                                    Archivo PDF seleccionado
                                </MudAlert>
                            }

                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">
                                * Requerido - Foto del empleado en su área
                            </MudText>
                        }
                    </MudStack>
                </MudItem>

                <!-- ✅ CARGA DE ARCHIVO - GARITA -->
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <InputFile id="fileInputGarita"
                                   OnChange="@(e => OnFileChangedInput(e, "garita"))"
                                   hidden
                                   accept="image/*,.pdf" />

                        <MudButton HtmlTag="label"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   FullWidth="true"
                                   for="fileInputGarita">
                            🚪 Subir Foto Garita
                        </MudButton>

                        @if (_archivoGarita != null)
                        {
                            <MudChip Color="Color.Success"
                                     Size="Size.Small"
                                     OnClose="@(() =>
                                                                                                                                                                                         {
                                                                                                                                                                                             _archivoGarita = null;
                                                                                                                                                                                             _previewGaritaBase64 = null;
                                                                                                                                                                                         })">
                        ✓ @_archivoGarita.Name (@FormatBytes(_archivoGarita.Size))
                    </MudChip>
                    @if (_previewGaritaBase64 != null)
                            {
                                <MudPaper Class="pa-1 mt-2" Elevation="1">
                                    <MudImage Src="@_previewGaritaBase64"
                                              Alt="Vista previa garita"
                                              Style="max-height:180px; width:100%; object-fit:cover; border-radius:8px;" />
                                </MudPaper>
                            }
                            else if (_archivoGarita != null && Path.GetExtension(_archivoGarita.Name).ToLower() == ".pdf")
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" />
                                    Archivo PDF seleccionado
                                </MudAlert>
                            }

                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">
                                * Requerido - Foto de garita norte / punto de salida
                            </MudText>
                        }
                    </MudStack>
                </MudItem>

                <!-- Información importante -->
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        <strong>Importante:</strong> La justificación será enviada a su superior inmediato para aprobación.
                        <br />
                        <strong>Formatos permitidos:</strong> JPG, PNG, PDF (máximo 10MB cada archivo)
                    </MudAlert>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CerrarDialogJustificacion">Cancelar</MudButton>
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Send"
                   Disabled="@(_archivoArea == null || _archivoGarita == null || string.IsNullOrEmpty(_tipoOmision))"
                   OnClick="GuardarJustificacion">
            @(_modoEdicion ? "Actualizar" : "Enviar Solicitud")
        </MudButton>
    </DialogActions>
</MudDialog>


<!-- ============================================================ -->
<!-- DIALOG: VER DETALLE DE JUSTIFICACIÓN -->
<!-- ============================================================ -->
<MudDialog @bind-IsVisible="_dialogDetalleVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
            Detalle de Justificación
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (_justificacionDetalle != null)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudChip Color="@ObtenerColorEstadoJustificacion(_justificacionDetalle.Estado)"
                             Size="Size.Large">
                        <strong>@_justificacionDetalle.Estado</strong>
                    </MudChip>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">
                        <strong>Tipo:</strong> @_justificacionDetalle.TipoOmision
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">
                        <strong>Fecha solicitud:</strong>
                        @_justificacionDetalle.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                    </MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Value="@(_justificacionDetalle.Observaciones ?? "")"
                                  Label="Observaciones del empleado"
                                  Lines="3"
                                  ReadOnly="true"
                                  Variant="Variant.Outlined" />
                </MudItem>


                <MudItem xs="12" md="6">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1">📷 Área de Trabajo</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            @if (!string.IsNullOrEmpty(_justificacionDetalle.FotoAreaTrabajo))
                            {
                                @if (_justificacionDetalle.FotoAreaTrabajo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                {
                                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                                                 Size="Size.Large"
                                                 Color="Color.Error"
                                                 Style="font-size: 4rem;" />
                                        <MudText Typo="Typo.body2">Archivo PDF</MudText>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Download"
                                                   Href="@GetUrlArchivo(_justificacionDetalle.FotoAreaTrabajo)"
                                                   Target="_blank">
                                            Ver PDF
                                        </MudButton>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudStack Spacing="1">
                                        <MudImage Src="@GetUrlArchivo(_justificacionDetalle.FotoAreaTrabajo)"
                                                  Alt="Foto área de trabajo"
                                                  Elevation="1"
                                                  Class="rounded-lg"
                                                  ObjectFit="ObjectFit.Cover"
                                                  Style="max-height: 250px; width: 100%; cursor: pointer;"
                                                  @onclick="@(() => AbrirImagenEnNuevaVentana(_justificacionDetalle.FotoAreaTrabajo))" />
                                        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Primary">
                                            <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" />
                                            Click para ampliar
                                        </MudText>
                                    </MudStack>
                                }
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">Sin evidencia fotográfica</MudAlert>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1">🚪 Garita</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            @if (!string.IsNullOrEmpty(_justificacionDetalle.FotoGarita))
                            {
                                @if (_justificacionDetalle.FotoGarita.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                {
                                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                                                 Size="Size.Large"
                                                 Color="Color.Error"
                                                 Style="font-size: 4rem;" />
                                        <MudText Typo="Typo.body2">Archivo PDF</MudText>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Download"
                                                   Href="@GetUrlArchivo(_justificacionDetalle.FotoGarita)"
                                                   Target="_blank">
                                            Ver PDF
                                        </MudButton>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudStack Spacing="1">
                                        <MudImage Src="@GetUrlArchivo(_justificacionDetalle.FotoGarita)"
                                                  Alt="Foto garita"
                                                  Elevation="1"
                                                  Class="rounded-lg"
                                                  ObjectFit="ObjectFit.Cover"
                                                  Style="max-height: 250px; width: 100%; cursor: pointer;"
                                                  @onclick="@(() => AbrirImagenEnNuevaVentana(_justificacionDetalle.FotoGarita))" />
                                        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Primary">
                                            <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" />
                                            Click para ampliar
                                        </MudText>
                                    </MudStack>
                                }
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">Sin evidencia fotográfica</MudAlert>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                @if (_justificacionDetalle.Estado != "SOLICITADO")
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body2">
                            <strong>@(_justificacionDetalle.Estado == "APROBADO" ? "Aprobado" : "Rechazado") por:</strong>
                            @(_justificacionDetalle.NombreAprobador ?? "N/A")
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body2">
                            <strong>Fecha:</strong>
                            @(_justificacionDetalle.FechaAprobacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </MudText>
                    </MudItem>

                    @if (!string.IsNullOrEmpty(_justificacionDetalle.ObservacionesAprobacion))
                    {
                        <MudItem xs="12">
                            <MudTextField Value="@_justificacionDetalle.ObservacionesAprobacion"
                                          Label="Observaciones del superior"
                                          Lines="2"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                    }
                }

                @if (_justificacionDetalle.Estado == "SOLICITADO")
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                    </MudItem>

                    @if (PuedeEditarJustificacion(_justificacionDetalle))
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Puede editar o cancelar su solicitud mientras esté pendiente
                            </MudAlert>
                        </MudItem>

                        <MudItem xs="12">
                            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                <MudButton Color="Color.Error"
                                           Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="CancelarSolicitudJustificacion">
                                    Cancelar Solicitud
                                </MudButton>

                                <MudButton Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Edit"
                                           OnClick="@(() => { CerrarDialogDetalle(); AbrirDialogEdicion(_justificacionDetalle); })">
                                    Editar
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    }
                    else if (PuedeAprobarRechazar())
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Usted puede aprobar o rechazar esta solicitud
                            </MudAlert>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_observacionesAprobacion"
                                          Label="Observaciones (opcional)"
                                          Lines="2"
                                          Variant="Variant.Outlined"
                                          MaxLength="500" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                <MudButton Color="Color.Error"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Cancel"
                                           OnClick="RechazarJustificacion">
                                    Rechazar
                                </MudButton>

                                <MudButton Color="Color.Success"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.CheckCircle"
                                           OnClick="AprobarJustificacion">
                                    Aprobar
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    }
                }
            </MudGrid>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CerrarDialogDetalle">Cerrar</MudButton>
    </DialogActions>
</MudDialog>



                                                 @bind-Value="_Contrato.NumeroContrato"
                                                 Label="Número de Contrato"
                                                 Step="1"
                                                 Min="1"
                                                 Max="9999"
                                                 Immediate="true" />

                                <MudSelect T="string" Label="Tipo de Contrato" @bind-Value="_Contrato.TipoContrato">
                                    <MudSelectItem Value="@("CONTRATO")"> CONTRATO </MudSelectItem>

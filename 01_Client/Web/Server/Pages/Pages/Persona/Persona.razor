@page "/Persona"
@using Infraestructura.Models.Persona
@using Infraestructura.Models.Clasificador
@using Microsoft.AspNetCore.Components
@using Syncfusion.Blazor.Grids
@using System.Globalization
@using Server.Pages.Pages.Biometrico
@using Infraestructura.Models.Biometrico
@using MudBlazor
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Charts
@using Aplicacion.DTOs.Charts
@using Syncfusion.Blazor.Buttons
@using Aplicacion.DTOs.Vacacion



@inherits MainBaseComponent
@layout   MainLayout
@inject   NavigationManager Navigation
@inject   NavigationManager Nav
@inject   NavigationManager NavigationManager

@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject IJSRuntime JS



<MudCard>
    <!-- Panel de formulario -->
    <MudExpansionPanels MultiExpansion="false">
        <MudExpansionPanel @bind-IsExpanded="expande" HideIcon="true">
            <TitleContent>
                <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mb-5 d-flex justify-center align-center">
                    <MudButton Variant="Variant.Outlined"
                               Style="@(expande ? "background-color: #A09B9B; color: white;" : "background-color: #4CAF50; color: white;")"
                               OnClick="@ToggleExpand">
                        @(expande ? "CERRAR" : "AGREGAR")
                    </MudButton>
                </MudContainer>
            </TitleContent>
            <ChildContent>
                <MudCard>
                    <EditForm Model="@_Persona" OnValidSubmit="OnValidPerfil" id="formPersona">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <MudCardContent>
                            <MudGrid>
                                <!--Nombre-->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @bind-Value="_Persona.Nombre"
                                                  Label="NOMBRE: "
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="100" />
                                </MudItem>

                                <!--Apellido Paterno-->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @bind-Value="_Persona.ApellidoPaterno"
                                                  Label="APELLIDO PATERNO: "
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="100" />
                                </MudItem>

                                <!--Apellido Materno-->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @bind-Value="_Persona.ApellidoMaterno"
                                                  Label="APELLIDO MATERNO: "
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="100" />
                                </MudItem>

                                <!-- Cédula de Identidad -->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @bind-Value="_Persona.Ci"
                                                  Label="CÉDULA DE IDENTIDAD: "
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="20" />
                                </MudItem>

                                <!-- Expedido -->
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" 
                                               Label="EXPEDIDO: " 
                                               @bind-Value="_Persona.Exp"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" >
                                        <MudSelectItem Value="@("LP")">LP - LA PAZ</MudSelectItem>
                                        <MudSelectItem Value="@("CB")">CB - COCHABAMBA </MudSelectItem>
                                        <MudSelectItem Value="@("SC")">SC - SANTA CRUZ</MudSelectItem>
                                        <MudSelectItem Value="@("CH")">CH - CHUQUISACA</MudSelectItem>
                                        <MudSelectItem Value="@("PT")">PT - POTOSI</MudSelectItem>
                                        <MudSelectItem Value="@("OR")">OR - ORURO</MudSelectItem>
                                        <MudSelectItem Value="@("TJ")">TJ - TARIJA</MudSelectItem>
                                        <MudSelectItem Value="@("BE")">BE - BENI</MudSelectItem>
                                        <MudSelectItem Value="@("PD")">PD - PANDO</MudSelectItem>
                                    </MudSelect>
                                </MudItem>

                                <!-- Extension CI -->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @bind-Value="_Persona.Extension"
                                                  Label="EXTENSION: "
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="20" />
                                </MudItem>

                                <!-- Celular -->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @bind-Value="_Persona.Celular"
                                                  Label="CELULAR: "
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="11"
                                                  Adornment="Adornment.Start"
                                                  AdornmentText="+591" />
                                </MudItem>

                                <!-- Fecha de Nacimiento -->
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker T="DateTime?"
                                                   @bind-Date="_Persona.FechaNacimiento"
                                                   Label="FECHA DE NACIMIENTO: "
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense" />
                                </MudItem>

                                <!-- Domicilio -->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @bind-Value="_Persona.Domicilio"
                                                  Label="DOMICILIO: "
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="100" />
                                </MudItem>

                                <!-- Residencia -->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @bind-Value="_Persona.Residencia"
                                                  Label="RESIDENCIA: "
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="100" />
                                </MudItem>

                                <!-- Correo -->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @bind-Value="_Persona.Correo"
                                                  Label="CORREO: "
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="100" />
                                </MudItem>



                                <!-- Profesión -->
                                <MudItem xs="12" sm="6" >
                                    <AutoSelectClasificador TItem="GenClasificadorDto"
                                                            Label="PROFESIÓN: "
                                                            Items="_ListaPrfesion"
                                                            IdProperty="IdgenClasificador"
                                                            DescriptionProperty="Descripcion"
                                                            MaxItems="50"
                                                            @bind-DataValue="_Persona.IdgenProfesion" />
                                </MudItem>


                                <!-- Nivel Salarial -->
                                <MudItem xs="12" sm="6" >
                                    <AutoSelectClasificador TItem="GenClasificadorDto"
                                                            Label="NIVEL SALARIAL: "
                                                            Items="_ListaSalario"
                                                            IdProperty="IdgenClasificador"
                                                            DescriptionProperty="Descripcion"
                                                            MaxItems="50"
                                                            @bind-DataValue="_Persona.IdgenNivelsalarial" />
                                </MudItem>

                                <!--Puesto Denominación-->
                                <MudItem xs="12" sm="6" >
                                    <AutoSelectClasificador TItem="GenClasificadorDto"
                                                            Label="PUESTO DENOMINACION: "
                                                            Items="_ListaPuestoDenominacion"
                                                            IdProperty="IdgenClasificador"
                                                            DescriptionProperty="Descripcion"
                                                            MaxItems="50"
                                                            @bind-DataValue="_Persona.IdgenPuestodenominacion" />
                                </MudItem>


                                <!--INMEDIATO SUPERIOR, INMEDIATO SUPERIOR-->
                               <MudItem xs="12" sm="6" md="4">
                                    <AutoSelectClasificador TItem="RrhPersonaDto"
                                                            Label="INMEDIATO SUPERIOR: "
                                                            Items="Tablapersona"
                                                            IdProperty="IdrrhPersona"
                                                            DescriptionProperty="NombreApellido"
                                                            MaxItems="50"
                                                            @bind-DataValue="_Persona.InmediatoSuperior" />
                                </MudItem> 


                                <!--Grupo Trabajo-->
                                <MudItem xs="12" sm="6" md="4">
                                    <MudSelect T="int?"
                                               Label="GRUPO TRABAJO: "
                                               @bind-Value="_Persona.IdgengrupoTrabajo"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense">
                                        @if (_ListaGrupoTrabajo is not null)
                                        {
                                            @foreach (var proveedor in _ListaGrupoTrabajo)
                                            {
                                                <MudSelectItem T="int?" Value="@proveedor.IdgenClasificador">
                                                    @proveedor.Descripcion
                                                </MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>

                                <!--Grupo Descripcion-->
                                <MudItem xs="12" sm="6" md="4">
                                    <AutoSelectClasificador TItem="GenClasificadorDto"
                                                            Label="DESCRIPCION PUESTO: "
                                                            Items="_ListaPuestoDescripcion"
                                                            IdProperty="IdgenClasificador"
                                                            DescriptionProperty="Descripcion"
                                                            @bind-DataValue="_Persona.IdgenPuestodescripcion" />
                                </MudItem> 

                                <!--Grupo Categoria-->
                                <MudItem xs="12" sm="6" md="4">
                                    <MudSelect T="int?"
                                               Label="CATEGORIA: "
                                               @bind-Value="_Persona.IdgenCategoria"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense">
                                        @if (_ListaCategoria is not null)
                                        {
                                            @foreach (var proveedor in _ListaCategoria)
                                            {
                                                <MudSelectItem T="int?" Value="@proveedor.IdgenClasificador">
                                                    @proveedor.Descripcion
                                                </MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>

                                <!--Grupo Clase-->
                                <MudItem xs="12" sm="6" md="4">
                                    <MudSelect T="int?"
                                               Label="CLASE: "
                                               @bind-Value="_Persona.IdgenClase"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense">
                                        @if (_ListaClase is not null)
                                        {
                                            @foreach (var proveedor in _ListaClase)
                                            {
                                                <MudSelectItem T="int?" Value="@proveedor.IdgenClasificador">
                                                    @proveedor.Descripcion
                                                </MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>

                                <!-- Genero -->
                                <MudItem xs="12" sm="6" md="4">
                                    <MudSelect T="string"
                                               Label="GENERO: "
                                               @bind-Value="_Persona.Sexo"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense">
                                        <MudSelectItem Value="@( "M" )">MASCULINO</MudSelectItem>
                                        <MudSelectItem Value="@( "F" )">FEMENINO</MudSelectItem>
                                    </MudSelect>
                                </MudItem>

                                <!-- Unidad Organizacional -->
                                <MudItem xs="12" sm="6" md="4">
                                    <AutoSelectClasificador TItem="GenClasificadorDto"
                                                            Label="UNIDAD ORGANIZACIONAL: "
                                                            Items="_ListaUnidad"
                                                            IdProperty="IdgenClasificador"
                                                            DescriptionProperty="Descripcion"
                                                            MaxItems="50"
                                                            @bind-DataValue="_Persona.IdgenUnidad" />
                                </MudItem>


                            </MudGrid>
                        </MudCardContent>

                        <MudCardActions>
                            <MudButton ButtonType="MudBlazor.ButtonType.Submit" 
                                       Variant="Variant.Outlined"
                                       Class="button-save button-spacing">
                                GUARDAR
                            </MudButton>
                            <MudButton ButtonType="MudBlazor.ButtonType.Button" 
                                       Variant="Variant.Outlined"
                                       OnClick="@ResetPerfil"
                                       Class="button-clean">
                                LIMPIAR FORMULARIO
                            </MudButton>
                        </MudCardActions>
                    </EditForm>

                </MudCard>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudCard>

<!--/////////////////////////////////////////////////////////////////////////////////////-->

<div class="container-center scroll-sync-container">
    <div class="full-width">
        <MudPaper Class="pa-4 mt-4" Elevation="5" Outlined="true">

            <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Success" Class="my-2">
                <b>LISTA DEL PERSONAL DE ENVIBOL</b>
            </MudText>

            <!-- Contenedor de tabla con scroll horizontal -->
            <div class="table_employee">
                <div>
                    <div class="table-scroll">
                        <MudTable Items="@Tablapersona"
                                  Hover="true"
                                  Bordered="true"
                                  Striped="true"
                                  Dense="true"
                                  Filter="new Func<RrhPersonaDto,bool>(FilterFunc1)">

                            <ToolBarContent>
                                <!-- Download Report -->
                                <MudTooltip Text="DESCARGAR REPORTE" Color="Color.Dark" Placement="Placement.Bottom">
                                    <MudIconButton Style="margin-top: 25px; margin-right: 20px;"
                                                   Color="@Color.Dark"
                                                   Variant="Variant.Filled"
                                                   Icon="@Icons.Material.Filled.FileDownload"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ExportarPersonas())" />
                                </MudTooltip>


                                <!-- Searcher -->
                                <MudTextField @bind-Value="searchString"
                                              Placeholder="Buscar"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              Immediate="true"
                                              DebounceInterval="300"
                                              Class="mt-4 mb-2" />
                            </ToolBarContent>

                            <HeaderContent>
                                <MudTh Style="text-align: left;">OPCIONES</MudTh> 
                                <MudTh Style="text-align: left;">ID PERSONA</MudTh>
                                <MudTh Style="text-align: left;">NOMBRE</MudTh>
                                <MudTh Style="text-align: left;">APELLIDO PATERNO</MudTh>
                                <MudTh Style="text-align: left;">APELLIDO MATERNO</MudTh>
                                <MudTh Style="text-align: left;">CI</MudTh>
                                <MudTh Style="text-align: left;">EXT</MudTh>
                                <MudTh Style="text-align: left;">EXP</MudTh>
                                <MudTh Style="text-align: left;">CELULAR</MudTh>
                                <MudTh Style="text-align: left;">CONTRASEÑA</MudTh>
                                <MudTh Style="text-align: left;">UNIDAD ORGANIZACIONAL</MudTh>
                                <MudTh Style="text-align: left;">CATEGORIA</MudTh>
                                <MudTh Style="text-align: left;">CLASE</MudTh>
                                <MudTh Style="text-align: left;">N. SALARIAL</MudTh>
                                <MudTh Style="text-align: left;">PUESTO DENOMINACION</MudTh>
                                <MudTh Style="text-align: left;">PROFESION</MudTh>
                                <MudTh Style="text-align: left;">GRUPO TRABAJO</MudTh>
                                <MudTh Style="text-align: left;">PUESTO DESCRIPCION</MudTh>
                                <MudTh Style="text-align: left;">SEXO</MudTh>
                                <MudTh Style="text-align: left;">FECHA NACIMIENTO</MudTh>
                                <MudTh Style="text-align: left;">DOMICILIO</MudTh>
                                <MudTh Style="text-align: left;">RESIDENCIA</MudTh>
                                <MudTh Style="text-align: left;">EDAD</MudTh>
                                <MudTh Style="text-align: left;">INMEDIATO SUPERIOR</MudTh>
                                <MudTh Style="text-align: left;">CORREO</MudTh>                    
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd>
                                    <MudTooltip Text="EDITAR REGISTRO" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => FormEditarPersona(context))"
                                                        Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" />
                                    </MudTooltip>


                                    <MudTooltip Text="ELIMINAR REGISTRO" Placement="Placement.Top">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => EliminarPersona(context.IdrrhPersona))"
                                                        Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" />
                                    </MudTooltip>


                                    <MudIconButton Icon="@(context.Estado == '1' ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                                                       Variant="Variant.Outlined"
                                                       Color="@(context.Estado == '1' ? Color.Success : Color.Secondary)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => CambiarEstado(context))" />


                                    <!--CONTRATOS-->
                                    <MudTooltip Text="MOSTRAR CONTRATO" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.GridView" OnClick="@(() => ShowPopu(context.IdrrhPersona))"
                                                        Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" />
                                    </MudTooltip>


                                    <!--FALTAS MEDICAS-->
                                    <MudTooltip Text="BAJA MEDICA" Placement="Placement.Bottom">
                                        <MudIconButton Icon="@Icons.Material.Filled.Sick" OnClick="@(() => ShowBajaMedica(context.IdrrhPersona))"
                                                       Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" />
                                    </MudTooltip>


                                    <!--VACACIONES-->
                                    <MudTooltip Text="VACACIONES" Placement="Placement.Bottom">
                                        <MudIconButton Icon="@Icons.Material.Filled.BeachAccess" OnClick="@(() => ShowVacacion(context.IdrrhPersona))"
                                                       Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" />
                                    </MudTooltip>


                                    <!--COMISIONES-->
                                    <MudTooltip Text="AUTORIZACION DE SALIDA" Placement="Placement.Bottom">
                                        <MudIconButton Icon="@Icons.Material.Filled.BusinessCenter" OnClick="@(() => ShowComision(context.IdrrhPersona))"
                                                       Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" />
                                    </MudTooltip>

                                </MudTd>
                  
                                <MudTd Class="text-center">@context.IdrrhPersona</MudTd>
                                <MudTd Class="text-center">@context.Nombre</MudTd>
                                <MudTd Class="text-center">@context.ApellidoPaterno</MudTd>
                                <MudTd Class="text-center">@context.ApellidoMaterno</MudTd>
                                <MudTd Class="text-center">@context.Ci</MudTd>
                                <MudTd Class="text-center">@context.Extension</MudTd>
                                <MudTd Class="text-center">@context.Exp</MudTd>
                                <MudTd Class="text-center">@context.Celular</MudTd>
                                <MudTd Class="text-center">@context.Contrasena</MudTd>
                                <MudTd Class="text-center">@GetUnidadDescripcion(context.IdgenUnidad)</MudTd>
                                <MudTd Class="text-center">@GetCategoriaDescripcion(context.IdgenCategoria)</MudTd>
                                <MudTd Class="text-center">@GetClaseDescripcion(context.IdgenClase) </MudTd>
                                <MudTd Class="text-center">@GetNivelSalarialDescripcion(context.IdgenNivelsalarial)</MudTd>
                                <MudTd Class="text-center">@GetPuestoDenominacionDescripcion(context.IdgenPuestodenominacion)</MudTd>
                                <MudTd Class="text-center">@GetProfesionDescripcion(context.IdgenProfesion)</MudTd>
                                <MudTd Class="text-center">@GetGrupoTrabajoDescripcion(context.IdgengrupoTrabajo)</MudTd>
                                <MudTd Class="text-center">@GetPuestoDescripcion(context.IdgenPuestodescripcion)</MudTd>
                                <MudTd Class="text-center">@context.Sexo</MudTd>
                                <MudTd Class="text-center">@(context.FechaNacimiento.HasValue ? context.FechaNacimiento.Value.ToString("dd/MM/yyyy") : "")</MudTd>
                                <MudTd Class="text-center">@context.Domicilio</MudTd>
                                <MudTd Class="text-center">@context.Residencia</MudTd>
                                <MudTd Class="text-center">@context.Edad</MudTd>
                                <MudTd Class="text-center">@SupervisorNombre(context.InmediatoSuperior)</MudTd>
                                <MudTd Class="text-center">@context.Correo</MudTd>                 

                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int [] {5,15,30,45,70,100} " /> <!--Rows per page ...-->
                            </PagerContent>
                        </MudTable>
                    </div>
                </div>
            </div>


            <!-- VACACIONES DE LOS EMPLEADOS, VACACIONES DE LOS EMPLEADOS, VACACIONES DE LOS EMPLEADOS ... -->
            <!-- ░░░░░  CABECERA DEL FUNCIONARIO  ░░░░░ -->

            <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Success" Class="my-2">
                <b>LISTA DEL PERSONAL DE ENVIBOL</b>
            </MudText>

   
            @if (PersonaSeleccionada != null)
            {
                <MudText Typo="Typo.h6">
                    Bienvenido, @PersonaSeleccionada.NombreApellido, @PersonaSeleccionada.Ci, @GetPuestoDescripcion(PersonaSeleccionada.IdgenPuestodescripcion)
                </MudText>
            }


            <div style="display: flex; justify-content: center; gap: 0px; flex-wrap: wrap; margin-top: 2rem; width: 100%; max-width: 1200px;">
                <div style="flex: 1 1 25%; min-width: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 400px;">
                    <h3 style="margin-bottom: 0.5rem;">PERSONAL TOTAL</h3>
                    <SfAccumulationChart>
                        <AccumulationChartLegendSettings Visible="false" />
                        <AccumulationChartSeriesCollection>
                            <AccumulationChartSeries DataSource="@DonutDataTotalPersonal"
                                                     XName="Category"
                                                     YName="Value"
                                                     Radius="80%"
                                                     InnerRadius="40%"
                                                     PointColorMapping="Color"
                                                     Explode="false">
                                <AccumulationDataLabelSettings Visible="true"
                                                               Name="Category"
                                                               Position="AccumulationLabelPosition.Inside">
                                    <AccumulationChartDataLabelFont Size="15px" FontWeight="600" />
                                </AccumulationDataLabelSettings>
                            </AccumulationChartSeries>
                        </AccumulationChartSeriesCollection>
                    </SfAccumulationChart>
                </div>

                <div style="flex: 1 1 25%; min-width: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 400px;">
                    <h3 style="margin-bottom: 0.5rem;">PERSONAL ADMINISTRATIVO</h3>
                    <SfAccumulationChart>
                        <AccumulationChartLegendSettings Visible="false" />
                        <AccumulationChartSeriesCollection>
                            <AccumulationChartSeries DataSource="@DonutAdministrativo"
                                                     XName="Category"
                                                     YName="Value"
                                                     Radius="80%"
                                                     InnerRadius="40%"
                                                     PointColorMapping="Color"
                                                     Explode="false">
                                <AccumulationDataLabelSettings Visible="true"
                                                               Name="Category"
                                                               Position="AccumulationLabelPosition.Inside">
                                    <AccumulationChartDataLabelFont Size="15px" FontWeight="600" />
                                </AccumulationDataLabelSettings>
                            </AccumulationChartSeries>
                        </AccumulationChartSeriesCollection>
                    </SfAccumulationChart>
                </div>

                <div style="flex: 1 1 25%; min-width: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 400px;">
                    <h3 style="margin-bottom: 0.5rem;">PERSONAL OPERATIVO</h3>
                    <SfAccumulationChart>
                        <AccumulationChartLegendSettings Visible="false" />
                        <AccumulationChartSeriesCollection>
                            <AccumulationChartSeries DataSource="@DonutOperativo"
                                                     XName="Category"
                                                     YName="Value"
                                                     Radius="80%"
                                                     InnerRadius="40%"
                                                     PointColorMapping="Color"
                                                     Explode="false">
                                <AccumulationDataLabelSettings Visible="true"
                                                               Name="Category"
                                                               Position="AccumulationLabelPosition.Inside">
                                    <AccumulationChartDataLabelFont Size="15px" FontWeight="600" />
                                </AccumulationDataLabelSettings>
                            </AccumulationChartSeries>
                        </AccumulationChartSeriesCollection>
                    </SfAccumulationChart>
                </div>
            </div>

            <!-- THE BAR CHART, BAR CHART, BAR CHART, BAR CHART, BAR CHART, BAR CHART -->
            <div style="display: flex; justify-content: center; gap: 0px; flex-wrap: wrap; margin-top: 2rem; width: 100%; max-width: 1600px;">

                <!-- Chart 1 -->
                <div style="flex: 1 1 40%; min-width: 200px; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 400px;">

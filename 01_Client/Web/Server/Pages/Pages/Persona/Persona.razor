                                                       Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" />
                                    </MudTooltip>

                                    <MudTooltip Text="ELIMINAR CONTRATO" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => EliminarContrato(context.IdrrhhContrato))"
                                                       Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" />

                                        GUARDAR
                                    </MudButton>
                                    <MudButton ButtonType="MudBlazor.ButtonType.Button" 
                                               Variant="Variant.Outlined"
                                               OnClick="@ResetTabla"
                                               Color="Color.Default">
                                        LIMPIAR
                                    </MudButton>
                                </MudCardActions>
                            </MudPaper>
                        </EditForm>
                    </MudCard>
                </div>
            </MudCardContent>
        </Content>

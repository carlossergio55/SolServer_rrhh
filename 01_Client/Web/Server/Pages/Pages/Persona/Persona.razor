                                <AutoSelectClasificador TItem="GenClasificadorDto"
                                                        Label="MOTIVO DE LA SALIDA: "
                                                        Items="_ListaMotivoComision"
                                                        IdProperty="IdgenClasificador"
                                                        DescriptionProperty="Descripcion"
                                                        MaxItems="50"
                                                        @bind-DataValue="_Comision.IdgenMotivoComision" />


                                <MudTextField T="string"
                                              @bind-Value="_Comision.JustificacionComision"
                                              Label="JUSTIFICACION: "
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Lines="4" />


                                <MudCardActions Class="mt-4">
                                    <MudButton ButtonType="MudBlazor.ButtonType.Submit"
                                               Variant="Variant.Outlined"
                                               Color="Color.Success"
                                               Class="ml-auto button-spacing">
                                        GUARDAR
                                    </MudButton>
                                    <MudButton ButtonType="MudBlazor.ButtonType.Button"
                                               Variant="Variant.Outlined"
                                               OnClick="@ResetTabla"
                                               Color="Color.Default">
                                        LIMPIAR
                                    </MudButton>
                                </MudCardActions>

                            </MudPaper>
                        </EditForm>
                    </MudCard>
                </div>
            </MudCardContent>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="CERRAR" OnClick="@btnCancelPop" />
    </DialogButtons>
</SfDialog>

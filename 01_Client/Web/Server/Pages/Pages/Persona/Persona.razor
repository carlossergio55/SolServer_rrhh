                                <MudTd Class="text-center">@context.IdrrhhPersona</MudTd>
                                <MudTd Class="text-center">@context.InicioContrato.Value.ToString("dd/MM/yyyy")</MudTd>
                                <MudTd Class="text-center">@context.FinContrato.Value.ToString("dd/MM/yyyy")</MudTd>
